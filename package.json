{
  "name": "udit-portfolio-app",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-csp.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && tsc -p e2e --noEmit && npm run check:tokens && npm run check:csp",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3"
  }
}
